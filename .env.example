# All variables are optional — the site builds and runs with none set.

# Canonical site URL (no trailing slash). Used for sitemap, RSS, JSON-LD, llms.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# PostHog analytics — free tier, 1M events/month: https://posthog.com/signup
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Tag Manager — free: https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=

# Crisp live chat — free plan: https://crisp.chat
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Sentry error tracking — free Developer plan: https://sentry.io/signup (not wired up yet)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
