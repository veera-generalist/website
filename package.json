{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir e2e",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/third-parties": "^14.2.35",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-slot": "^1.3.3",
    "@tabler/icons-react": "^3.48.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "gray-matter": "^4.0.3",
    "lottie-react": "^3.1.2",
    "next": "14.2.35",
    "next-mdx-remote": "^4.4.1",
    "posthog-js": "^1.434.17",
    "react": "^18",
    "react-dom": "^18",
    "reading-time": "^1.5.0",
    "schema-dts": "^2.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwind-variants": "^0.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md,mdx,yml,yaml}": "prettier --write"
  }
}
